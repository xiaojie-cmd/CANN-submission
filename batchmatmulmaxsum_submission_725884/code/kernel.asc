// SPDX-License-Identifier: Apache-2.0
// v19 safe multicore optimization of the v18 baseline.
// Batch parallelism plus guarded M-tile parallelism, capped at 20 AI Cores.
// Fused BatchMatmulMaxSum: positive B/M/N/K, including M/N/K tail tiles.
// A/B are FP16 or BF16; their physical layout follows the transpose flags.
// y[b] = sum_m max_n (sum_k float(A[b,m,k]) * float(B[b,k,n])).
// Uses the synchronous Matmul path only; no async producer/consumer loop.

#include <algorithm>
#include <cstdint>
#include <vector>
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"

using namespace AscendC;
using namespace matmul;

// Batch-rich inputs use one AIC per batch. For batch-poor, compute-heavy
// inputs, independent M tiles are distributed across AICs and merged later.
template <typename InputT>
__global__ __aicore__ void batch_matmul_max_sum_custom(
    GM_ADDR a, GM_ADDR b, GM_ADDR y, GM_ADDR workspace,
    GM_ADDR partialWorkspace, GM_ADDR tilingGm,
    uint32_t batch, uint32_t mSize, uint32_t nSize, uint32_t kSize,
    uint32_t tileM, uint32_t tileN, uint32_t blockNum,
    bool transposeX1, bool transposeX2, bool useMSplit)
{
    AscendC::InitSocState();
    // Tiling data lives in GM. Copy it to scalar/kernel-local storage once.
    TCubeTiling tiling;
    auto src = reinterpret_cast<__gm__ uint32_t *>(tilingGm);
    auto dst = reinterpret_cast<uint32_t *>(&tiling);
    for (uint32_t i = 0; i < sizeof(TCubeTiling) / sizeof(uint32_t); ++i) {
        dst[i] = src[i];
    }

    TPipe pipe;
    // v18 no unsafe double buffer:
    // keep one C tile buffer to avoid queue deadlock risk.
    // On dav-2201, GetSysWorkSpacePtr reads the KFC register, not the
    // deprecated block-local workspace pointer. Matmul's AIC/AIV message
    // queue must use the workspace allocated by the host.
    SetSysWorkspaceForce(workspace);

    GlobalTensor<InputT> aGm;
    GlobalTensor<InputT> bGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> partialGm;
    aGm.SetGlobalBuffer(reinterpret_cast<__gm__ InputT *>(a),
                        static_cast<uint64_t>(batch) * mSize * kSize);
    bGm.SetGlobalBuffer(reinterpret_cast<__gm__ InputT *>(b),
                        static_cast<uint64_t>(batch) * kSize * nSize);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batch);
    const uint32_t blockId = GetBlockIdx();
    const uint32_t mTileCount = (mSize + tileM - 1) / tileM;
    if (useMSplit) {
        // Eight floats (32 bytes) per tile keep every GM write aligned.
        partialGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ float *>(partialWorkspace),
            static_cast<uint64_t>(batch) * mTileCount * 8);
    }

    Matmul<MatmulType<TPosition::GM, CubeFormat::ND, InputT, true>,
           MatmulType<TPosition::GM, CubeFormat::ND, InputT, true>,
           MatmulType<TPosition::VECIN, CubeFormat::ND, float>> mm;
    // CANN 9.0 dav-2201: clear the per-block KFC message area and signal
    // WORKSPACE_SYNC_ID before the Vector side waits during registration.
    AscendC::clearWorkspace(workspace);
    // CANN requires registration before any TPipe::InitBuffer in decoupled mode.
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);

    // Matmul API produces one baseM*baseN FP32 tile in UB/VECIN. There is
    // deliberately only ONE C-tile buffer: no complete C matrix in GM/UB.
    TQue<QuePosition::VECOUT, 1> cQueue;
    TQue<QuePosition::VECOUT, 1> yQueue;
    TBuf<TPosition::VECCALC> rowMaxBuf;
    TBuf<TPosition::VECCALC> oneMaxBuf;
    TBuf<TPosition::VECCALC> rowSumBuf;
    TBuf<TPosition::VECCALC> reduceWorkBuf;
    pipe.InitBuffer(cQueue, 1, tileM * tileN * sizeof(float));
    pipe.InitBuffer(yQueue, 1, 32);
    pipe.InitBuffer(rowMaxBuf, tileM * sizeof(float));
    pipe.InitBuffer(oneMaxBuf, 32);
    pipe.InitBuffer(rowSumBuf, 32);
    // 128x256 C tiles need more reduction scratch than the 128-column baseline.
    pipe.InitBuffer(reduceWorkBuf, 1024);
    auto rowMax = rowMaxBuf.Get<float>();
    auto oneMax = oneMaxBuf.Get<float>();
    auto rowSum = rowSumBuf.Get<float>();
    auto reduceWork = reduceWorkBuf.Get<float>();

    const uint32_t batchBegin = useMSplit ? 0 : blockId;
    const uint32_t batchStep = useMSplit ? 1 : blockNum;
    for (uint32_t batchId = batchBegin; batchId < batch; batchId += batchStep) {
        const uint64_t aBatch = static_cast<uint64_t>(batchId) * mSize * kSize;
        const uint64_t bBatch = static_cast<uint64_t>(batchId) * kSize * nSize;
        float batchSum = 0.0f;

        // Flattened work index is batchId*mTileCount+mTileId. This formula
        // assigns every M tile to exactly one block without an atomic counter.
        const uint32_t firstMTile = useMSplit
            ? (blockId + blockNum - static_cast<uint32_t>(
                   (static_cast<uint64_t>(batchId) * mTileCount) % blockNum)) % blockNum
            : 0;
        const uint32_t mTileStep = useMSplit ? blockNum : 1;
        for (uint32_t mTileId = firstMTile;
             mTileId < mTileCount; mTileId += mTileStep) {
            const uint32_t m0 = mTileId * tileM;
            const uint32_t validM = tileM < mSize - m0 ? tileM : mSize - m0;
            // For each row, retain max over ALL N tiles, not just this tile.
            for (uint32_t n0 = 0; n0 < nSize; n0 += tileN) {
                const uint32_t validN = tileN < nSize - n0 ? tileN : nSize - n0;
                // SetOrgShape(M,N,K) in host tiling preserves the strides of
                // the original ND matrices despite the smaller tile shape.
                const uint64_t aOffset = transposeX1 ? m0 : static_cast<uint64_t>(m0) * kSize;
                const uint64_t bOffset = transposeX2 ? static_cast<uint64_t>(n0) * kSize : n0;
                mm.SetTensorA(aGm[aBatch + aOffset], transposeX1);
                mm.SetTensorB(bGm[bBatch + bOffset], transposeX2);
                mm.SetTail(validM, validN, kSize);

                // With SetShape(tileM,tileN,K) and baseM/N=tileM/N, Iterate
                // produces exactly one C tile; K is accumulated by the Cube.
                if (mm.Iterate()) {
                    auto cTile = cQueue.AllocTensor<float>();
                    mm.template GetTensorC<true>(cTile, 0, true);
                    cQueue.EnQue(cTile);
                    cTile = cQueue.DeQue<float>();

                    // GetTensorC transfers C to VECIN. ReduceMax is a Vector
                    // operation, applied immediately; C never goes to GM.
                    for (uint32_t row = 0; row < validM; ++row) {
                        float value;
                        if (validN < tileN) {
                            // GetTensorC<true> packs an N tail with stride
                            // validN (not tileN). A row after the first may
                            // start at an unaligned address, so use scalar
                            // reads for this correctness-first tail path.
                            value = cTile.GetValue(row * validN);
                            for (uint32_t col = 1; col < validN; ++col) {
                                const float v = cTile.GetValue(row * validN + col);
                                value = value > v ? value : v;
                            }
                        } else {
                            ReduceMax<float>(oneMax, cTile[row * tileN],
                                             reduceWork, validN, false);
                            value = oneMax.GetValue(0);
                        }
                        if (n0 == 0) {
                            rowMax.SetValue(row, value);
                        } else {
                            const float old = rowMax.GetValue(row);
                            rowMax.SetValue(row, old > value ? old : value);
                        }
                    }
                    cQueue.FreeTensor(cTile);
                }
            }

            // Vector reduction across M rows, then scalar accumulation across
            // M tiles. Only tileM row maxima are retained at any moment.
            ReduceSum<float>(rowSum, rowMax, reduceWork, validM);
            const float tileSum = rowSum.GetValue(0);
            if (useMSplit) {
                auto partialLocal = yQueue.AllocTensor<float>();
                partialLocal.SetValue(0, tileSum);
                yQueue.EnQue(partialLocal);
                partialLocal = yQueue.DeQue<float>();
                const uint64_t partialOffset =
                    (static_cast<uint64_t>(batchId) * mTileCount + mTileId) * 8;
                DataCopy(partialGm[partialOffset], partialLocal, 8);
                yQueue.FreeTensor(partialLocal);
            } else {
                batchSum += tileSum;
            }
        }

        if (!useMSplit) {
            auto yLocal = yQueue.AllocTensor<float>();
            yLocal.SetValue(0, batchSum);
            yQueue.EnQue(yLocal);
            yLocal = yQueue.DeQue<float>();
            // One FP32 result is 4 bytes, so use the unaligned copy API.
            DataCopyExtParams outCopy{1, sizeof(float), 0, 0, 0};
            DataCopyPad(yGm[batchId], yLocal, outCopy);
            yQueue.FreeTensor(yLocal);
        }
    }
    mm.End();
    if (useMSplit) {
        // Every launched block reaches this single barrier exactly once.
        // Block 0 then adds partials in original M-tile order, preserving the
        // baseline accumulation order and avoiding atomic FP32 additions.
        // The user code runs on the Vector side of the decoupled Matmul
        // kernel. Sync only the participating AIV blocks. SyncAll<false>()
        // also waits for AIC-side callers, which do not execute this branch
        // after Matmul registration and therefore deadlocks on dav-2201.
        SyncAll();
        if (blockId == 0) {
            for (uint32_t batchId = 0; batchId < batch; ++batchId) {
                float batchSum = 0.0f;
                for (uint32_t mTileId = 0; mTileId < mTileCount; ++mTileId) {
                    const uint64_t partialOffset =
                        (static_cast<uint64_t>(batchId) * mTileCount + mTileId) * 8;
                    batchSum += partialGm.GetValue(partialOffset);
                }
                auto yLocal = yQueue.AllocTensor<float>();
                yLocal.SetValue(0, batchSum);
                yQueue.EnQue(yLocal);
                yLocal = yQueue.DeQue<float>();
                DataCopyExtParams outCopy{1, sizeof(float), 0, 0, 0};
                DataCopyPad(yGm[batchId], yLocal, outCopy);
                yQueue.FreeTensor(yLocal);
            }
        }
    }
}

// Host-side tiling and kernel launch.
extern "C" int run_kernel(
    GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2,
    GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream,
    bool transposeX1, bool transposeX2)
{
    (void)info_y;
    if (availableCoreNum <= 0 || info_x1.numTensors <= 0 ||
        info_x2.numTensors <= 0 || info_x1.tensors == nullptr ||
        info_x2.tensors == nullptr) {
        return 1;
    }
    if (info_x1.tensors[0].numDims < 3 || info_x2.tensors[0].numDims < 3 ||
        info_x1.tensors[0].shape == nullptr ||
        info_x2.tensors[0].shape == nullptr) {
        return 1;
    }
    const auto* shape = info_x1.tensors[0].shape;
    const uint32_t batch = static_cast<uint32_t>(shape[0]);
    const uint32_t mSize = static_cast<uint32_t>(shape[transposeX1 ? 2 : 1]);
    const uint32_t kSize = static_cast<uint32_t>(shape[transposeX1 ? 1 : 2]);
    const uint32_t nSize = static_cast<uint32_t>(info_x2.tensors[0].shape[transposeX2 ? 1 : 2]);
    const bool isBf16 = info_x1.tensors[0].dtype == 2;
    if (batch == 0 || mSize == 0 || nSize == 0 || kSize == 0) {
        return 1;
    }
    constexpr uint32_t kMaxAicores = 20;
    const uint32_t maxCoreCount = static_cast<uint32_t>(
        std::min<int64_t>(kMaxAicores, availableCoreNum));

    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance(aclrtGetSocName());
    if (platform == nullptr) {
        return 1;
    }

    // Search M up to 128 and N up to 256, falling back if Matmul tiling or
    // the current shape cannot support the larger tile. For a batch-poor,
    // compute-heavy shape, prefer M=64 so at least four independent M tiles
    // are available from M>=256; this exposes useful parallel work to AICs.
    // Matmul SetTail uses the real M/N/K on each tile; baseM/N stay aligned.
    optiling::TCubeTiling cubeTiling;

    const bool preferParallelM = batch < maxCoreCount && mSize >= 256 &&
        static_cast<uint64_t>(nSize) * kSize >= 65536;
    const uint32_t candidateMs[] = {128, 96, 64, 32, 16};
    const uint32_t candidateNs[] = {256, 224, 192, 160, 128, 96, 64, 32, 16};
    uint32_t tileM = 0, tileN = 0;
    for (uint32_t candidateM : candidateMs) {
        if (tileM != 0) break;
        if (preferParallelM && candidateM > 64) continue;
        if (candidateM > ((mSize + 15) / 16) * 16) continue;
        for (uint32_t candidateN : candidateNs) {
            if (candidateN > ((nSize + 15) / 16) * 16) continue;
            matmul_tiling::MatmulApiTiling tiling(*platform);
            const auto inputType = isBf16 ? matmul_tiling::DataType::DT_BFLOAT16
                                          : matmul_tiling::DataType::DT_FLOAT16;
            tiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                            inputType, transposeX1);
            tiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                            inputType, transposeX2);
            tiling.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::ND,
                            matmul_tiling::DataType::DT_FLOAT);
            tiling.SetShape(std::min(candidateM, mSize),
                            std::min(candidateN, nSize), kSize);
            tiling.SetOrgShape(mSize, nSize, kSize);
            // CANN 9.0 does not allow a fixed baseK here; let it tile K.
            if (tiling.SetFixSplit(candidateM, candidateN, -1) == -1) continue;
            tiling.SetBufferSpace(-1, -1, -1);
            if (tiling.GetTiling(cubeTiling) != -1 &&
                cubeTiling.get_baseM() == candidateM &&
                cubeTiling.get_baseN() == candidateN) {
                tileM = candidateM;
                tileN = candidateN;
                break;
            }
        }
    }
    if (tileM == 0) {
        return 1;
    }
    const uint32_t mTileCount = (mSize + tileM - 1) / tileM;
    // The barrier is worthwhile only when there are at least four M tiles and
    // each tile performs enough N*K work. Otherwise retain batch scheduling.
    const bool useMSplit = batch < maxCoreCount && mTileCount >= 4 &&
        static_cast<uint64_t>(nSize) * kSize >= 4096;
    // AIV-only SyncAll synchronizes the blocks launched by this kernel, so do
    // not launch idle blocks when there are fewer M tiles than available
    // cores. This reduces block startup and barrier overhead.
    const uint32_t blockNum = useMSplit
        ? static_cast<uint32_t>(std::min<uint64_t>(
              maxCoreCount, static_cast<uint64_t>(batch) * mTileCount))
        : std::min<uint32_t>(maxCoreCount, batch);
    if (blockNum == 0 || blockNum > kMaxAicores) {
        return 1;
    }
    std::vector<uint8_t> hostTiling(sizeof(optiling::TCubeTiling));
    cubeTiling.SaveToBuffer(hostTiling.data(), hostTiling.size());
    uint8_t* deviceTiling = nullptr;
    uint8_t* workspace = nullptr;
    const size_t libWorkspaceBytes = platform->GetLibApiWorkSpaceSize();
    const size_t partialWorkspaceOffset = useMSplit
        ? (libWorkspaceBytes + size_t(511)) & ~size_t(511)
        : libWorkspaceBytes;
    const size_t partialWorkspaceBytes = useMSplit
        ? static_cast<size_t>(batch) * mTileCount * 8 * sizeof(float)
        : 0;
    const size_t workspaceBytes = partialWorkspaceOffset + partialWorkspaceBytes;
    if (aclrtMalloc(reinterpret_cast<void**>(&deviceTiling), hostTiling.size(),
                    ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&workspace), workspaceBytes,
                    ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        if (deviceTiling) aclrtFree(deviceTiling);
        if (workspace) aclrtFree(workspace);
        return 1;
    }
    if (aclrtMemcpy(deviceTiling, hostTiling.size(), hostTiling.data(),
                    hostTiling.size(), ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        aclrtFree(deviceTiling);
        aclrtFree(workspace);
        return 1;
    }
    if (isBf16) {
        batch_matmul_max_sum_custom<bfloat16_t><<<blockNum, nullptr, stream>>>(
            x1, x2, y, workspace, workspace + partialWorkspaceOffset, deviceTiling,
            batch, mSize, nSize, kSize, tileM, tileN, blockNum,
            transposeX1, transposeX2, useMSplit);
    } else {
        batch_matmul_max_sum_custom<half><<<blockNum, nullptr, stream>>>(
            x1, x2, y, workspace, workspace + partialWorkspaceOffset, deviceTiling,
            batch, mSize, nSize, kSize, tileM, tileN, blockNum,
            transposeX1, transposeX2, useMSplit);
    }
    const aclError result = aclrtSynchronizeStream(stream);
    aclrtFree(deviceTiling);
    aclrtFree(workspace);
    if (result != ACL_SUCCESS) {
        return 1;
    }
    return 0;
}
